# Gatekeeper Bot
BOT_TOKEN=
BOT_USERNAME=jrvisibut2

# MTProto (my.telegram.org)
API_ID=
API_HASH=

# Session encryption (Fernet key, generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Database (service hostnames for `docker-compose up`;
# use localhost instead if running backend/bot/worker outside Docker)
DATABASE_URL=postgresql+asyncpg://autopilot:autopilot@postgres:5432/autopilot

# Redis (cache, queues, rate limiting)
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO

# Gatekeeper bot
REQUIRED_CHANNELS=@your_channel
WEBAPP_URL=https://app.your-domain.example

# Domain served by Caddy for the Mini App (point a DNS A record at this VPS
# before `docker compose up`)
APP_DOMAIN=app.your-domain.example

# Telegram user_id (not username) of accounts allowed to see the admin/stats
# section inside the Mini App, comma-separated. Get your id from @userinfobot.
ADMIN_TELEGRAM_IDS=

# AI replies for Pro (optional; leave AI_PROVIDER empty to hide the feature).
# Free start: OpenRouter free models (https://openrouter.ai/models?q=free),
# e.g. AI_PROVIDER=openai_compat, AI_MODEL=qwen/qwen3.8-27b:free. The free
# roster changes often — if replies stop, pick another ":free" model.
# Later: AI_PROVIDER=anthropic with a Claude API key (AI_MODEL defaults to
# claude-opus-5). AI_BASE_URL is only used by openai_compat.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_DAILY_LIMIT=50
